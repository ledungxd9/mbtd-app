# App MBTD (Blazor WebAssembly PWA) — sinh bởi Dtool\Mobile\tools\pack_dtoolvn.ps1; thư mục /app của dtool.vn (LiteSpeed / OnePanel iNET).
# Thư mục con có RewriteEngine riêng → luật của .htaccess gốc (www → dtool.vn, http → https) không chạy ở đây nên nhắc lại.
Options -Indexes -MultiViews
DirectoryIndex index.html
<IfModule mod_mime.c>
  AddType application/wasm .wasm
  AddType application/octet-stream .dat
  AddType model/gltf-binary .glb
  AddType application/manifest+json .webmanifest
  AddType text/javascript .js .mjs
  AddType application/json .json
</IfModule>
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /app/
  RewriteCond %{HTTP_HOST} ^www\.dtool\.vn$ [NC]
  RewriteRule ^ https://dtool.vn%{REQUEST_URI} [R=301,L]
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://dtool.vn%{REQUEST_URI} [R=301,L]
  # trang trong app (/app/sua, /app/hien-trang…): không có file → index.html (Blazor tự định tuyến)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/wasm application/octet-stream application/manifest+json
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "^(index\.html|service-worker\.js|service-worker-assets\.js|manifest\.webmanifest|BUILD\.txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>